<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/test_input_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/test_input_description"
            android:textSize="14sp" />

        <Button
            android:id="@+id/select_ime_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/test_input_select_ime" />

        <EditText
            android:id="@+id/test_input_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/test_input_hint_single"
            android:inputType="text"
            android:imeOptions="actionNext" />

        <EditText
            android:id="@+id/test_input_multi"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:gravity="top|start"
            android:hint="@string/test_input_hint_multi"
            android:inputType="textMultiLine"
            android:scrollHorizontally="false" />

        <Button
            android:id="@+id/clear_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_input_clear" />

    </LinearLayout>

</ScrollView>
